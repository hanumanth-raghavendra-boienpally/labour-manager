# Copy this file to  .env  (same folder) and fill in your own values. .env is git-ignored.
# Paste each URL exactly as your provider gives it (Render: Connections -> External Database URL; Neon: Connection string).

# DB1 = the agent database: the 49 tables (labor_allocation + legacy). The AI agent writes here; this app only reads it.
DB1_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/labor_db

# DB2 = the workflow database: approvals, rejections, allocations, notifications, audit log (schema "workflow").
# A separate database is recommended. On a local PostgreSQL the app creates it automatically if it does not exist.
# Only one Postgres URL? Leave DB2_URL commented out: DB2 then lives in the same database as DB1, in its own "workflow" schema.
# DB2_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/labour_db2

# Optional
# TOKEN_SECRET=paste-a-long-random-string-here (40+ characters)
# AGENT_REQUEST_STATUSES=PUBLISHED      (agent_playbook.status values that count as a request; e.g. PUBLISHED,DRAFT)
# AGENT_POLL_MS=1500                    (how often DB1 is checked for a new agent dump)
# PORT=8080
